# Copy to `.env` (git-ignored). Only variables prefixed with VITE_ are exposed to the browser,
# so NEVER put secrets here: everything in the built site is public.

# Base URL of the backend API. Leave empty in development (Vite proxies /api to localhost:4000).
# In production set it to your deployed API, e.g. https://api.dennismaina.dev
VITE_API_URL=

# Public URL of the deployed site. Used to build absolute social-preview (Open Graph) image URLs.
VITE_SITE_URL=
