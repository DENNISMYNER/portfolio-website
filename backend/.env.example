# Copy this file to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

# --- Server -------------------------------------------------------------
NODE_ENV=development
PORT=4000
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- CORS ---------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# Development: the Vite dev server. Production: your deployed site, e.g. https://dennismaina.dev
CORS_ORIGIN=http://localhost:5173

# --- Reverse proxy ------------------------------------------------------
# Number of proxies in front of the app (Render, Railway, Fly, Heroku... = 1).
# Needed so rate limiting sees the visitor's real IP. Leave 0 when running locally.
TRUST_PROXY=0

# --- Contact form rate limit (per IP) -----------------------------------
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15

# --- Email delivery -----------------------------------------------------
# console = print messages to the server log (development only)
# smtp    = send a real email (required when NODE_ENV=production)
EMAIL_TRANSPORT=console

# Only needed when EMAIL_TRANSPORT=smtp
CONTACT_TO_EMAIL=you@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The authenticated sender shown in your inbox, e.g. "Portfolio <no-reply@example.com>"
SMTP_FROM=
